:root{--ink:#252622;--paper:#f7f6f1;--blue:#4b61bd;--coral:#b97866;--lime:#c9cfae;--violet:#a9a0c5;--line:rgba(37,38,34,.15);--soft:#efeee8}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.45}a{color:inherit;text-decoration:none}.nav{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:18px 4vw;background:rgba(245,244,237,.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.brand{font-weight:650;letter-spacing:-.035em}.navlinks{display:flex;gap:22px;flex-wrap:wrap;font-size:13px;font-weight:550;text-transform:uppercase}.navlinks a:hover{color:var(--blue)}main{width:min(1200px,92vw);margin:auto}.hero{padding:10vh 0 8vh;border-bottom:1px solid var(--line)}.eyebrow{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.12em;margin-bottom:18px}.hero h1{font-size:clamp(58px,9.5vw,118px);line-height:.88;letter-spacing:-.065em;margin:0 0 35px;max-width:1000px}.hero p{font-size:clamp(19px,2.1vw,27px);max-width:760px;letter-spacing:-.02em}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-block;padding:13px 18px;border:2px solid var(--ink);font-weight:800}.btn.primary{background:var(--blue);color:white;border-color:var(--blue)}.btn:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}.section{padding:92px 0;border-bottom:1px solid var(--line)}.section h2{font-size:clamp(36px,5.2vw,68px);letter-spacing:-.055em;line-height:.94;margin:0 0 35px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{border:1px solid var(--line);padding:27px;min-height:230px;display:flex;flex-direction:column;justify-content:space-between;transition:background .2s,border-color .2s,transform .2s}.card:hover{transform:translateY(-3px);background:#eeede7;border-color:rgba(37,38,34,.35)}.tag{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.card h3{font-size:30px;letter-spacing:-.045em;margin:15px 0 8px}.card p{color:#444}.accent-blue{background:#e8ebf6}.accent-lime{background:#eef0e5}.accent-coral{background:#f2e9e5}.accent-violet{background:#eeeaf4}.split{display:grid;grid-template-columns:1fr 2fr;gap:40px}.list{border-top:1px solid var(--ink)}.row{display:grid;grid-template-columns:1fr 2fr auto;gap:18px;padding:20px 0;border-bottom:1px solid var(--line)}.row strong{font-size:17px;font-weight:550}.row span{color:#444}.footer{padding:55px 0;display:flex;justify-content:space-between;gap:20px}.small{font-size:13px}@media(max-width:800px){.nav{align-items:flex-start;gap:15px;flex-direction:column}.navlinks{gap:12px}.grid{grid-template-columns:1fr}.split{grid-template-columns:1fr}.row{grid-template-columns:1fr}.hero h1{font-size:clamp(58px,19vw,110px)}}
